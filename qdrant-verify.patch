+import asyncio
+import json
+from dataclasses import asdict
+
+import pytest
+from qdrant_client import QdrantClient, models
+
+from app.startup_checks import check_index_matches_data
+from config import COLLECTION
+from db_ops.utils import build_point_id
+from tests.db_ops.verify_helpers import DIM, make_chunks, populate
+
+
+@pytest.fixture
+def chunk_dir(tmp_path):
+    directory = tmp_path / "chunks"
+    directory.mkdir()
+    chunks = make_chunks()
+    for document in {c.document for c in chunks}:
+        lines = [json.dumps(asdict(c)) for c in chunks if c.document == document]
+        (directory / f"{document}.jsonl").write_text("\n".join(lines) + "\n")
+    return directory
+
+
+@pytest.fixture
+def client():
+    client = QdrantClient(":memory:")
+    populate(client, COLLECTION, make_chunks())
+    return client
+
+
+def run_check(client, chunk_dir, dense_size=DIM):
+    asyncio.run(
+        check_index_matches_data(dense_size, client=client, chunk_dir=chunk_dir)
+    )
+
+
+def test_a_matching_collection_starts_and_a_missing_index_only_warns(
+    client, chunk_dir, caplog
+):
+    # the in-memory client never has a payload index, which makes it a handy "missing index"
+    run_check(client, chunk_dir)
+    assert "no payload index on" in caplog.text
+
+
+def test_a_missing_point_stops_startup_and_says_to_embed(client, chunk_dir, caplog):
+    chunk = make_chunks()[0]
+    client.delete(
+        COLLECTION, models.PointIdsList(points=[build_point_id(chunk.chunk_id)])
+    )
+    with pytest.raises(RuntimeError, match="run mrr embed"):
+        run_check(client, chunk_dir)
+    assert "[Doc A]: jsonl [4] | qdrant [3]" in caplog.text
+
+
+def test_a_config_mismatch_stops_startup(client, chunk_dir):
+    # the collection holds 8-wide dense vectors, the model says 1024
+    with pytest.raises(RuntimeError, match="run mrr embed"):
+        run_check(client, chunk_dir, dense_size=1024)
diff --git a/tests/db_ops/test_index_matches_data.py b/tests/db_ops/test_index_matches_data.py
new file mode 100644
index 0000000..669180d
--- /dev/null
+++ b/tests/db_ops/test_index_matches_data.py
@@ -0,0 +1,105 @@
+"""Checks the real Qdrant collection against the chunk jsonl in data/processed/.
+
+These need a running Qdrant with the collection embedded, so they are marked
+`qdrant` and skipped by default. Run them after an embed, on the machine whose
+Qdrant you want to check:
+
+    pytest -m qdrant                       # all of them
+    VERIFY_SEED=123 pytest -m qdrant -k vectors   # repeat a vector sample
+
+They skip themselves when Qdrant is unreachable or the collection does not exist.
+The logic lives in db_ops/verify.py, which is tested without a server in
+test_verify.py.
+"""
+
+import os
+
+import pytest
+from fastembed import SparseTextEmbedding, TextEmbedding
+from qdrant_client import QdrantClient
+
+from config import (
+    CHUNKS_DIR,
+    COLLECTION,
+    DENSE_MODEL_NAME,
+    QDRANT_URL,
+    SPARSE_MODEL_NAME,
+)
+from db_ops.utils import load_jsonl_dir
+from db_ops.verify import (
+    check_config,
+    check_counts,
+    check_ids,
+    check_indexes,
+    check_payloads,
+    check_vectors,
+)
+from extraction_ops.models import Chunk
+
+pytestmark = pytest.mark.qdrant
+
+EMBED_HINT = "run mrr embed"
+
+
+def fail_if(problems: list[str], hint: str) -> None:
+    if problems:
+        pytest.fail("\n".join([*problems, hint]), pytrace=False)
+
+
+@pytest.fixture(scope="module")
+def client() -> QdrantClient:
+    client = QdrantClient(url=QDRANT_URL, timeout=30)
+    try:
+        exists = client.collection_exists(COLLECTION)
+    except Exception as e:  # noqa: BLE001 - any connection failure means skip
